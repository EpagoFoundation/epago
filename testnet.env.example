# Epago testnet environment — copy to .env (docker compose) or source it in
# the shell that runs `epago validator run` / `epago eval serve`.
# Every EPAGO_* variable overrides the matching chain.toml field or
# epago/constants.py default; unset variables fall back to mainnet values.
# Full walkthrough: docs/TESTNET.md.

# --- chain -------------------------------------------------------------------
# Netuid assigned by `btcli subnet create --network test`.
EPAGO_NETUID=0
# Subtensor network: "test" for testnet (chain.toml ships "finney").
EPAGO_NETWORK=test

# --- emissions: mainnet-equivalent from block one ------------------------------
# Zeroing the deterministic Phase A->B gate makes it fire at genesis, so
# emissions behave exactly like steady-state mainnet from the first block.
# This is the supported "no burn" configuration. NEVER set these on mainnet.
EPAGO_PHASE_B_MIN_CLEAN_DUELS=0
EPAGO_PHASE_B_MIN_DETHRONES=0
EPAGO_PHASE_B_MIN_BLOCKS=0

# --- commitment channels --------------------------------------------------------
# Blocks between a verdict commit and its chain-stamped reveal. Re-pin after
# measuring real reveal latency with `epago chain check --probe-writes`.
EPAGO_VERDICT_REVEAL_BLOCKS=5

# --- CPU/GPU split ---------------------------------------------------------------
# Where the validator (CPU box) reaches the rollout/eval server (GPU box).
# In docker compose this is http://eval:8900; leave unset for a single box
# running both processes locally.
EPAGO_EVAL_URL=http://127.0.0.1:8900
# Shared bearer token; the eval server rejects requests without it. Generate
# with e.g. `openssl rand -hex 32`.
EPAGO_EVAL_TOKEN=change-me

# --- private task pool --------------------------------------------------------------
# Drop directory for post-snapshot documents feeding the private pool
# (also settable per-run via `epago validator run --ingest-dir`).
EPAGO_INGEST_DIR=/data/ingest

# --- publication -------------------------------------------------------------------
# Repo that receives rotated private pools and delayed audit bundles.
EPAGO_PUBLISH_REPO=your-org/epago-testnet-audit

# --- judge ---------------------------------------------------------------------------
# The pinned LLM-judge fallback. Enabled on mainnet; disable on GPU-starved
# testnet boxes to grade with programmatic matching only (exact + alias).
EPAGO_ENABLE_LLM_JUDGE=1

# --- eval throughput ---------------------------------------------------------
# Concurrent rollouts per duel (step-batched through the engine). Raise until
# the eval GPU saturates; lower on memory-constrained cards.
# EPAGO_ROLLOUT_CONCURRENCY=16
# One engine resident at a time (halves peak VRAM; one model reload per duel).
# EPAGO_EVAL_LOW_VRAM=0
# Explicit per-engine share of GPU memory (vLLM gpu_memory_utilization).
# EPAGO_VLLM_GPU_MEM_UTIL=
