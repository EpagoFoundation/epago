# Copy to docker/.env and fill in. docker/.env is gitignored — never commit it.
# Run compose from this directory:  cd docker && docker compose up -d

# --- required ---
EPAGO_NETUID=385
EPAGO_NETWORK=test                 # "finney" for mainnet, "test" for testnet

# Active chain generation (contract). Defaults to the 30B evidence-extraction
# contract; override only to run a different generation.
# EPAGO_CHAIN_TOML=/app/chains/EPAGO-DR-30B.toml

# --- wallet (mounted read-only into the validator) ---
EPAGO_WALLET_DIR=~/.bittensor       # host path to your bittensor wallets
EPAGO_WALLET_NAME=default
EPAGO_WALLET_HOTKEY=default

# --- serving ---
EPAGO_DASHBOARD_PORT=8080
WATCHTOWER_INTERVAL=300             # seconds between image-update checks

# --- auto-rounds (optional): open a competition round on a schedule ---
# The chain enforces the ~2-day floor (ROUND_MIN_INTERVAL_BLOCKS), so firing
# more often is harmless — an early request is accepted and then ignored.
# Enable:  set the two below, then  docker compose --profile auto-rounds up -d
# EPAGO_ROUND_API_BIND=0.0.0.0:8799  # validator serves POST /round/start here
# EPAGO_ROUND_API_KEY=               # shared secret (validator + scheduler)
# EPAGO_ROUND_INTERVAL_S=21600       # scheduler poke cadence (default 6h)

# --- auto-holdout (optional): rotate the private holdout feed weekly ---
# One cycle = harvest a fresh dated window -> publish a PRIVATE dated dataset
# repo -> write the new [private_source] pin to /state/holdout/last-rotation.json
# (+ private_source.toml) for you to commit into chains/*.toml.
# Enable:  set HUGGINGFACE_TOKEN below, then
#          docker compose --profile auto-holdout up -d
# HUGGINGFACE_TOKEN=                 # HF token with WRITE access to the holdout org
# EPAGO_HOLDOUT_INTERVAL_S=604800    # rotation cadence (default 7 days)
# EPAGO_HOLDOUT_MIN_PAPERS=800       # refuse to publish a slice thinner than this
# EPAGO_HOLDOUT_MODE=--dry-run       # rehearse without publishing (default: --apply)

# --- testnet operational overrides (leave commented for mainnet defaults) ---
# EPAGO_N_PUB_TASKS=16
# EPAGO_N_PRIV_TASKS=16
# EPAGO_EVAL_LOW_VRAM=1
# EPAGO_VLLM_GPU_MEM_UTIL=0.42
# EPAGO_FORMAT_PROBE_PASS=2
# EPAGO_PHASE_B_MIN_BLOCKS=0
# EPAGO_PHASE_B_MIN_CLEAN_DUELS=0
# EPAGO_PHASE_B_MIN_DETHRONES=0
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- Hippius S3 content store (models, corpus, validator state) ---
# HIPPIUS_BUCKET=                    # shared subnet bucket (globally unique name)
# HIPPIUS_ACCESS_KEY=
# HIPPIUS_SECRET_KEY=
# HIPPIUS_ENDPOINT=https://s3.hippius.com   # override only for a regional endpoint
# HIPPIUS_REGION=decentralized

# --- credentials (fill when deploying; keep out of git) ---
# HF_TOKEN=                          # optional: only to read the external fresh-feed dataset
# EPAGO_EVAL_TOKEN=                 # bearer auth between validator and eval
# --- optional hosted LLM judge (NON-CANONICAL, testnet/experimental) ---
# EPAGO_ENABLE_LLM_JUDGE=1
# EPAGO_JUDGE_API_BASE=
# EPAGO_JUDGE_API_MODEL=
# EPAGO_JUDGE_API_KEY=
